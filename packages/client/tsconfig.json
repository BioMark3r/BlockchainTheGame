{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "rootDir": "../../",
    "outDir": "dist",
    "paths": {
      "@shared/*": ["../../src/shared/*"]
    }
  },
  "include": ["src", "../../src/shared", "../../src/engine"]
}
