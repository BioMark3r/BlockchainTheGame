{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "composite": true
  },
  "references": [
    { "path": "./packages/client" },
    { "path": "./packages/server" }
  ]
}
