# WebSocket server URL for the client to connect to.
# If omitted, the client auto-connects to ws(s)://<same-hostname>:3001
# so it works for local dev and remote access without changing this value.
# Only set this if your WebSocket server is on a different host or port.
# VITE_WS_URL=wss://your-server-domain.com

# Port the WebSocket server listens on
PORT=3001
